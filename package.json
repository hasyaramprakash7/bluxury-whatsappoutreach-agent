{
  "name": "bluxury-outreach-agent",
  "version": "2.0.0",
  "private": true,
  "description": "WhatsApp outreach for leads from the map-ai lead finder: AI suggests messages from each business's website problems, you pick and send. Cloudflare Workers, D1, Workers AI.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply bluxury-outreach --local",
    "db:migrate:remote": "wrangler d1 migrations apply bluxury-outreach --remote",
    "deploy": "wrangler deploy",
    "check": "node --check public/app.js && wrangler deploy --dry-run --outdir .wrangler/dry"
  },
  "dependencies": {
    "hono": "4.13.19"
  },
  "devDependencies": {
    "wrangler": "4.166.0"
  }
}

{
  // Bluxury Outreach Agent: WhatsApp outreach to leads from the map-ai lead finder.
  // Deploy: npm run deploy  ·  Live: https://whatsapp-agent-outreach.hasya7893828468.workers.dev
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsapp-agent-outreach",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Dashboard files. API, webhook and health run in the Worker first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhook", "/health"]
  },

  // Settings, leads and messages (SQLite).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bluxury-outreach",
      "database_id": "cb9b477f-24f9-45bd-994b-c9f9a40da387",
      "migrations_dir": "migrations"
    }
  ],

  // Earlier versions of this Worker had two Durable Objects; v2 removes them.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ConversationDO", "BusinessHub"] },
    { "tag": "v2", "deleted_classes": ["ConversationDO", "BusinessHub"] }
  ],

  // Workers AI writes the message suggestions.
  "ai": { "binding": "AI" },

  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "GRAPH_API_VERSION": "v25.0",
    "GRAPH_BASE_URL": "https://graph.facebook.com"
  }
  // Secrets (wrangler secret put / .dev.vars): ADMIN_API_KEY, TOKEN_ENCRYPTION_KEY, WHATSAPP_VERIFY_TOKEN, META_APP_SECRET
}
